# Copy this file to .env.local and fill in real values.
#
# Get Sanity values from https://sanity.io/manage (or run `npx sanity manage` from ../studio/).
# Both this app and ../studio/ must use the SAME projectId and dataset.

# --- Client-side (exposed to browser) — REQUIRED for Sanity images in the browser ---
# Use the same project id as SANITY_STUDIO_PROJECT_ID in ../studio/.env
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

NEXT_PUBLIC_SUPABASE_URL=https://pmrhemcukhrwpyovqgjn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Legacy Vite names still work in scripts during migration (optional):
# VITE_SANITY_PROJECT_ID=
# VITE_SANITY_DATASET=production
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# --- Server-only (add to Vercel dashboard — never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=generate-a-random-secret-string-for-cron-auth
# ALLOW_OPEN_ADMIN_REFRESH=true  # Dev only — disable before production

# Optional overrides
# SITE_URL=https://edutoolshub.com
# SUPABASE_URL=  # fallback if NEXT_PUBLIC_SUPABASE_URL is unset
