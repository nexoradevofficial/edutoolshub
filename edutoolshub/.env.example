# Copy this file to .env.local and fill in real values.
# These values are baked into the build at compile time by Vite.
#
# Get them from https://sanity.io/manage (or run `npx sanity manage` from ../studio/).
# Both this app and ../studio/ must use the SAME projectId and dataset.

VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Supabase — get from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://pmrhemcukhrwpyovqgjn.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-only (do NOT prefix with VITE_) — add these to Vercel dashboard too:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# CRON_SECRET=generate-a-random-secret-string-for-cron-auth
# Also add CRON_SECRET to Vercel → Project Settings → Environment Variables
# ALLOW_OPEN_ADMIN_REFRESH=true  # TODO: disable before production; add auth instead
