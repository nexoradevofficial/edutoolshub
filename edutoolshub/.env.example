# Copy this file to .env.local and fill in real values.
# These values are baked into the build at compile time by Vite.
#
# Get them from https://sanity.io/manage (or run `npx sanity manage` from ../studio/).
# Both this app and ../studio/ must use the SAME projectId and dataset.

VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
