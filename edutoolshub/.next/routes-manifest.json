{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/blog/null",
      "destination": "/blog",
      "statusCode": 307,
      "regex": "^(?!/_next)/blog/null(?:/)?$"
    },
    {
      "source": "/tools/exam-marks-needed",
      "destination": "/tools/final-grade-calculator",
      "statusCode": 308,
      "regex": "^(?!/_next)/tools/exam-marks-needed(?:/)?$"
    },
    {
      "source": "/tools/gpa-requirement-checker",
      "destination": "/tools/college-university-gpa-requirement-checker",
      "statusCode": 308,
      "regex": "^(?!/_next)/tools/gpa-requirement-checker(?:/)?$"
    },
    {
      "source": "/tools/gpa-requirement-checker/:slug",
      "destination": "/tools/college-university-gpa-requirement-checker/:slug",
      "statusCode": 308,
      "regex": "^(?!/_next)/tools/gpa-requirement-checker(?:/([^/]+?))(?:/)?$"
    }
  ],
