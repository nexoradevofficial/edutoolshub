en":[{"_key":"85a127790c32","_type":"span","marks":[],"text":"⚠️ ImportantSome schools use a more modest scale — awarding +0.5 for Honors and +1.0 for AP — while others only apply the boost to AP and IB, not Honors. Your school's specific policy matters. Always check your student handbook or ask your counselor."}],"markDefs":[],"style":"normal"},{"_key":"4051f6b9f167","_type":"block","children":[{"_key":"ae8048d20333","_type":"span","marks":[],"text":"3. Weighted vs Unweighted GPA: A Side-by-Side Example"}],"markDefs":[],"style":"h2"},{"_key":"af1a84ce6982","_type":"block","children":[{"_key":"b056dc31cd6d","_type":"span","marks":[],"text":"Say you're a junior who took five classes this semester. Here's how the two GPA types produce different numbers for the same student:"}],"markDefs":[],"style":"normal"},{"_key":"ff90aab8d343","_type":"block","children":[{"_key":"ea2be1524157","_type":"span","marks":[],"text":"Course"}],"markDefs":[],"style":"normal"},{"_key":"a91230990001","_type":"block","children":[{"_key":"65b0727c8cfd","_type":"span","marks":[],"text":"Level"}],"markDefs":[],"style":"normal"},{"_key":"843fe2ef3ea6","_type":"block","children":[{"_key":"b54262903bf2","_type":"span","marks":[],"text":"Grade"}],"markDefs":[],"style":"normal"},{"_key":"21e625b70355","_type":"block","children":[{"_key":"df22b55d647e","_type":"span","marks":[],"text":"Unweighted Points"}],"markDefs":[],"style":"normal"},{"_key":"2ba705f19b5f","_type":"block","children":[{"_key":"6bb4c752f109","_type":"span","marks":[],"text":"Weighted Points"}],"markDefs":[],"style":"normal"},{"_key":"947fa5b0dd9b","_type":"block","children":[{"_key":"0e25c50ea861","_type":"span","marks":[],"text":"AP U.S. History"}],"markDefs":[],"style":"normal"},{"_key":"87dabf8b1a17","_type":"block","children":[{"_key":"a413d6589477","_type":"span","marks":[],"text":"AP"}],"markDefs":[],"style":"normal"},{"_key":"6824f5389a41","_type":"block","children":[{"_key":"8c459848fcf6","_type":"span","marks":[],"text":"A"}],"markDefs":[],"style":"normal"},{"_key":"56d5943fd957","_type":"block","children":[{"_key":"3545d4f99796","_type":"span","marks":[],"text":"4.0"}],"markDefs":[],"style":"normal"},{"_key":"3c09583b47ee","_type":"block","children":[{"_key":"c8b14429f7c4","_type":"span","marks":[],"text":"5.0"}],"markDefs":[],"style":"normal"},{"_key":"51400afc6dc1","_type":"block","children":[{"_key":"f2d0f6c6cc52","_type":"span","marks":[],"text":"Honors English"}],"markDefs":[],"style":"normal"},{"_key":"db2ec50f7f15","_type":"block","children":[{"_key":"a03bf43a818f","_type":"span","marks":[],"text":"Honors"}],"markDefs":[],"style":"normal"},{"_key":"9829c5a5fd4f","_type":"block","children":[{"_key":"6af48f76cbb1","_type":"span","marks":[],"text":"B+"}],"markDefs":[],"style":"normal"},{"_key":"64cc09b1ada3","_type":"block","children":[{"_key":"d86d973cf443","_type":"span","marks":[],"text":"3.3"}],"markDefs":[],"style":"normal"},{"_key":"8b19914aa2cf","_type":"block","children":[{"_key":"8eecd8bcfb9a","_type":"span","marks":[],"text":"3.8"}],"markDefs":[],"style":"normal"},{"_key":"d8c59e0e67ed","_type":"block","children":[{"_key":"b75583300f46","_type":"span","marks":[],"text":"AP Calculus BC"}],"markDefs":[],"style":"normal"},{"_key":"c064a5bee00c","_type":"block","children":[{"_key":"877936783e8b","_type":"span","marks":[],"text":"AP"}],"markDefs":[],"style":"normal"},{"_key":"d3c9579f2e58","_type":"block","children":[{"_key":"a297b4225f7d","_type":"span","marks":[],"text":"A−"}],"markDefs":[],"style":"normal"},{"_key":"5be0c39cf12a","_type":"block","children":[{"_key":"a8aee382540b","_type":"span","marks":[],"text":"3.7"}],"markDefs":[],"style":"normal"},{"_key":"4d5ff7bb3b40","_type":"block","children":[{"_key":"db3a23e480f8","_type":"span","marks":[],"text":"4.7"}],"markDefs":[],"style":"normal"},{"_key":"d18ea4334a48","_type":"block","children":[{"_key":"88911aaeb565","_type":"span","marks":[],"text":"Standard PE"}],"markDefs":[],"style":"normal"},{"_key":"382f38e1d8f6","_type":"block","children":[{"_key":"2ceb174009ca","_type":"span","marks":[],"text":"Standard"}],"markDefs":[],"style":"normal"},{"_key":"ba014a910af6","_type":"block","children":[{"_key":"ef3f80474adf","_type":"span","marks":[],"text":"A"}],"markDefs":[],"style":"normal"},{"_key":"a07b3ce64aee","_type":"block","children":[{"_key":"d9e4b12516db","_type":"span","marks":[],"text":"4.0"}],"markDefs":[],"style":"normal"},{"_key":"d2875c036421","_type":"block","children":[{"_key":"0db43a54e01e","_type":"span","marks":[],"text":"4.0"}],"markDefs":[],"style":"normal"},{"_key":"ea7a8724fcdd","_type":"block","children":[{"_key":"2539bae99a2f","_type":"span","marks":[],"text":"Honors Spanish"}],"markDefs":[],"style":"normal"},{"_key":"5ae77d9b9032","_type":"block","children":[{"_key":"bf2838216827","_type":"span","marks":[],"text":"Honors"}],"markDefs":[],"style":"normal"},{"_key":"34f8b2b86ff2","_type":"block","children":[{"_key":"ed1b0b9f64ad","_type":"span","marks":[],"text":"B"}],"markDefs":[],"style":"normal"},{"_key":"afa35658f486","_type":"block","children":[{"_key":"96e338125204","_type":"span","marks":[],"text":"3.0"}],"markDefs":[],"style":"normal"},{"_key":"4506b5a417c3","_type":"block","children":[{"_key":"db79d05f28bd","_type":"span","marks":[],"text":"3.5"}],"markDefs":[],"style":"normal"},{"_key":"675c4dcc2603","_type":"block","children":[{"_key":"3d0733cce7b0","_type":"span","marks":["strong"],"text":"GPA Total"}],"markDefs":[],"style":"normal"},{"_key":"f14afaf8405b","_type":"block","children":[{"_key":"630a354b18e2","_type":"span","marks":[],"text":"—"}],"markDefs":[],"style":"normal"},{"_key":"e16b33c6ae0d","_type":"block","children":[{"_key":"1c28d5e6a2ad","_type":"span","marks":[],"text":"—"}],"markDefs":[],"style":"normal"},{"_key":"ab510c65a3ed","_type":"block","children":[{"_key":"3b4599d2c89c","_type":"span","marks":["strong"],"text":"3.60"}],"markDefs":[],"style":"normal"},{"_key":"cfd49d5cd85d","_type":"block","children":[{"_key":"458dbd8d0164","_type":"span","marks":["strong"],"text":"4.20"}],"markDefs":[],"style":"normal"},{"_key":"5554c7dcb857","_type":"block","children":[{"_key":"b8f1c78e8c9b","_type":"span","marks":["strong"],"text":"Same student. Same semester. Two very different numbers — and both are accurate."}],"markDefs":[],"style":"normal"},{"_key":"1fd429d63657","_type":"block","children":[{"_key":"dad085d146cb","_type":"span","marks":[],"text":"\"Your weighted GPA is your story of ambition. Your unweighted GPA is your story of execution. Colleges want to read both.\"— College counseling adage widely shared by high school advisors"}],"markDefs":[],"style":"blockquote"},{"_key":"6838c874aada","_type":"block","children":[{"_key":"99cc258b8fb0","_type":"span","marks":["151e6ac850ef"],"text":"Calculate your GPA right now — free"}],"markDefs":[{"_key":"151e6ac850ef","_type":"link","href":"https://edutoolshub.com/tools/gpa-calculator"}],"style":"h3"},{"_key":"f80b829c6ac7","_type":"block","children":[{"_key":"721bbd082dbb","_type":"span","marks":["151e6ac850ef"],"text":"Supports both weighted and unweighted scales. No signup required. Results in under 60 seconds."}],"markDefs":[{"_key":"151e6ac850ef","_type":"link","href":"https://edutoolshub.com/tools/gpa-calculator"}],"style":"normal"},{"_key":"761cb3bb92f0","_type":"block","children":[{"_key":"0fc6f95cb783","_type":"span","marks":["151e6ac850ef"],"text":"Use GPA Calculator →"}],"markDefs":[{"_key":"151e6ac850ef","_type":"link","href":"https://edutoolshub.com/tools/gpa-calculator"}],"style":"normal"},{"_key":"b8bdb03e934b","_type":"block","children":[{"_key":"f3bfef9029fb","_type":"span","marks":[],"text":"4. Which GPA Do Colleges Care About?"}],"markDefs":[],"style":"h2"},{"_key":"76c39a32868c","_type":"block","children":[{"_key":"e7c0e3133625","_type":"span","marks":[],"text":"The honest answer: "},{"_key":"af956ca25264","_type":"span","marks":["strong"],"text":"both, but in different ways"},{"_key":"1596bd3e8ffb","_type":"span","marks":[],"text":"."}],"markDefs":[],"style":"normal"},{"_key":"2c2c40d118fa","_type":"block","children":[{"_key":"152f7d248e00","_type":"span","marks":[],"text":"Unweighted GPA"}],"markDefs":[],"style":"h4"},{"_key":"e7447832c5b5","_type":"block","children":[{"_key":"798ac71a9e1e","_type":"span","marks":[],"text":"Measured on 4.0 scale"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"c2c1db43f70c","_type":"block","children":[{"_key":"fe3f550a6a72","_type":"span","marks":[],"text":"Allows fair comparisons across schools"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"4c4d236af7a5","_type":"block","children":[{"_key":"c35eea5e2729","_type":"span","marks":[],"text":"Used in most college ranking averages"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"a4b06be2e343","_type":"block","children":[{"_key":"668ed7955944","_type":"span","marks":[],"text":"What most scholarships require"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"0461880332df","_type":"block","children":[{"_key":"1fff0a98e14a","_type":"span","marks":[],"text":"Colleges often recalculate to this"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"af272fa5f764","_type":"block","children":[{"_key":"445be00be02f","_type":"span","marks":[],"text":"Weighted GPA"}],"markDefs":[],"style":"h4"},{"_key":"fe74cc345dad","_type":"block","children":[{"_key":"834403ecb492","_type":"span","marks":[],"text":"Measured on 5.0 scale (typically)"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"a3e3227bfe94","_type":"block","children":[{"_key":"124ac127dcc2","_type":"span","marks":[],"text":"Signals course rigor & ambition"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"1f46701bb72b","_type":"block","children":[{"_key":"cc8060d77edf","_type":"span","marks":[],"text":"Key for selective college admissions"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"5754b726286c","_type":"block","children":[{"_key":"673f459d7963","_type":"span","marks":[],"text":"Rewards AP / IB / Honors effort"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"cad6b78b71f4","_type":"block","children":[{"_key":"431af711166f","_type":"span","marks":[],"text":"Can exceed 4.0"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"c7730082d43f","_type":"block","children":[{"_key":"eeeb0f0be013","_type":"span","marks":[],"text":"What the Common App asks"}],"markDefs":[],"style":"h3"},{"_key":"fde22e8322e3","_type":"block","children":[{"_key":"e08deb11e4f8","_type":"span","marks":[],"text":"The "},{"_key":"eb31a4e09775","_type":"span","marks":["strong"],"text":"Common Application"},{"_key":"2fc97aa0bb47","_type":"span","marks":[],"text":" — used by over 900 colleges — asks students to self-report their cumulative GPA and scale (e.g., 3.85 / 4.0 or 4.2 / 5.0). Report whichever scale your school officially uses on your transcript. If your school uses a weighted 5.0 scale, report that. "},{"_key":"627e1d3f66a3","_type":"span","marks":["strong"],"text":"Do not convert unless the application specifically asks you to."}],"markDefs":[],"style":"normal"},{"_key":"52636c523b90","_type":"block","children":[{"_key":"6a6967ed58f2","_type":"span","marks":[],"text":"📌 Key factMany selective colleges — including the entire University of California system — recalculate your GPA themselves using their own formula. They strip out non-academic electives and apply their own weighting. Your reported GPA is a starting point, not the final word."}],"markDefs":[],"style":"normal"},{"_key":"8514626d8053","_type":"block","children":[{"_key":"2054ac3fc507","_type":"span","marks":[],"text":"5. How to Calculate Your Weighted GPA: Step by Step"}],"markDefs":[],"style":"h2"},{"_key":"01c3c9b2f26a","_type":"block","children":[{"_key":"ab379f4cffcf","_type":"span","marks":["strong"],"text":"Find your school's weighting policy."},{"_key":"521341b37c54","_type":"span","marks":[],"text":" Does it weight Honors, or only AP/IB? Is the max 4.5 or 5.0?"}],"level":1,"listItem":"number","markDefs":[],"style":"normal"},{"_key":"06cdd51a97a8","_type":"block","children":[{"_key":"dbdd6f5a2429","_type":"span","marks":["strong"],"text":"Assign weighted grade points"},{"_key":"201e9ac6351f","_type":"span","marks":[],"text":" to each course using the appropriate scale (standard, Honors, or AP/IB)."}],"level":1,"listItem":"number","markDefs":[],"style":"normal"},{"_key":"bbd8d1b503a1","_type":"block","children":[{"_key":"2e06943c48e9","_type":"span","marks":["strong"],"text":"Multiply grade points × credit hours"},{"_key":"0c6a5469f772","_type":"span","marks":[],"text":" for each class to get quality points."}],"level":1,"listItem":"number","markDefs":[],"style":"normal"},{"_key":"10d57aec608a","_type":"block","children":[{"_key":"3580205e186d","_type":"span","marks":["strong"],"text":"Add up all quality points"},{"_key":"6637038ce044","_type":"span","marks":[],"text":" across all classes."}],"level":1,"listItem":"number","markDefs":[],"style":"normal"},{"_key":"04940546f979","_type":"block","children":[{"_key":"0894420db209","_type":"span","marks":["strong"],"text":"Divide by total credit hours"},{"_key":"4bf333ad2ae9","_type":"span","marks":[],"text":" taken."}],"level":1,"listItem":"number","markDefs":[],"style":"normal"},{"_key":"aa922327a1e0","_type":"block","children":[{"_key":"709138475801","_type":"span","marks":[],"text":"🧮 Formula "},{"_key":"44c6dcd73956","_type":"span","marks":["strong"],"text":"Weighted GPA = Σ (weighted grade points × credits) ÷ Σ (credits)"}],"markDefs":[],"style":"normal"},{"_key":"c6f788691be4","_type":"block","children":[{"_key":"46270f065fb9","_type":"span","marks":[],"text":"Skip the math — use our "},{"_key":"0a7b0ce99af1","_type":"span","marks":["8959bc2987c8","strong"],"text":"free GPA Calculator"},{"_key":"95e6165f4be8","_type":"span","marks":[],"text":" to handle both weighted and unweighted calculations instantly, with no signup required."}],"markDefs":[{"_key":"8959bc2987c8","_type":"link","href":"https://edutoolshub.com/tools/gpa-calculator"}],"style":"normal"},{"_key":"5cbb0e2fbe00","_type":"block","children":[{"_key":"77a08283e729","_type":"span","marks":[],"text":"6. Common Mistakes Students Make with GPA"}],"markDefs":[],"style":"h2"},{"_key":"c158e1e6966e","_type":"block","children":[{"_key":"26abdba6c9aa","_type":"span","marks":[],"text":"Mistake 1: Reporting the wrong GPA type"}],"markDefs":[],"style":"h3"},{"_key":"daca743d15c9","_type":"block","children":[{"_key":"2a18d51223b4","_type":"span","marks":[],"text":"If a scholarship application asks for your \"GPA on a 4.0 scale\" and you submit a 4.6 weighted GPA, you've answered the wrong question. Read prompts carefully — and when in doubt, submit both and note which is which."}],"markDefs":[],"style":"normal"},{"_key":"c0c3d790d658","_type":"block","children":[{"_key":"b241cb6aeba3","_type":"span","marks":[],"text":"Mistake 2: Assuming weighted is always higher"}],"markDefs":[],"style":"h3"},{"_key":"c8ae78fa3268","_type":"block","children":[{"_key":"cfc1b5de4c7e","_type":"span","marks":[],"text":"A student who takes challenging courses but earns Bs and Cs could end up with a "},{"_key":"1a91df9337db","_type":"span","marks":["em"],"text":"lower"},{"_key":"50bc1ec9c035","_type":"span","marks":[],"text":" weighted GPA than their unweighted one — if the bonus points don't offset the lower grades. Course selection and performance are a package deal."}],"markDefs":[],"style":"normal"},{"_key":"c740d7b575a3","_type":"block","children":[{"_key":"956b1d751d72","_type":"span","marks":[],"text":"Mistake 3: Not knowing your school's scale"}],"markDefs":[],"style":"h3"},{"_key":"9f04c8c61f78","_type":"block","children":[{"_key":"b1f5e0a4db67","_type":"span","marks":[],"text":"Some schools cap Honors at 4.5 and AP at 5.0. Others only give weight to AP and IB, not Honors. A handful of schools use a 100-point or percentage system entirely. Don't assume — verify with your counselor."}],"markDefs":[],"style":"normal"},{"_key":"70241b92067e","_type":"block","children":[{"_key":"6d7befdec20f","_type":"span","marks":[],"text":"Mistake 4: Forgetting that colleges recalculate anyway"}],"markDefs":[],"style":"h3"},{"_key":"11a49c02b938","_type":"block","children":[{"_key":"2fdc863cc7ac","_type":"span","marks":[],"text":"Many selective colleges recalculate your GPA using their own formula — stripping out PE, study hall, and electives, and applying their own weighting. Your reported GPA is a reference point, not the number they'll use."}],"markDefs":[],"style":"normal"},{"_key":"23f6b6db8e8a","_type":"block","children":[{"_key":"a86e96c3635d","_type":"span","marks":[],"text":"✅ Pro tip Know both your weighted and unweighted GPA cold. Calculate them using our "},{"_key":"e6027220f238","_type":"span","marks":["552bdf4cfe16"],"text":"free GPA Calculator"},{"_key":"d00796d735e4","_type":"span","marks":[],"text":", then write both numbers down so you can report accurately on any application."}],"markDefs":[{"_key":"552bdf4cfe16","_type":"link","href":"https://edutoolshub.com/tools/gpa-calculator"}],"style":"normal"},{"_key":"bca526d5ebda","_type":"block","children":[{"_key":"6b4d3c8966c4","_type":"span","marks":[],"text":"7. Weighted GPA and Scholarships: What You Need to Know"}],"markDefs":[],"style":"h2"},{"_key":"d54c18025d09","_type":"block","children":[{"_key":"584371ed05f5","_type":"span","marks":[],"text":"Most merit-based scholarships set a minimum GPA requirement, and they "},{"_key":"4e25aac53d90","_type":"span","marks":["strong"],"text":"almost always mean unweighted GPA on a 4.0 scale"},{"_key":"ab48d50ad171","_type":"span","marks":[],"text":". If a scholarship requires a 3.5 GPA and your unweighted GPA is 3.4, it doesn't matter that your weighted GPA is 4.1 — you may not qualify."}],"markDefs":[],"style":"normal"},{"_key":"6552fe89fd07","_type":"block","children":[{"_key":"1b3f11fe92f6","_type":"span","marks":[],"text":"Always read the fine print. When a scholarship application is vague, email the organization and ask specifically which GPA type they want. This one question can save you hours of wasted applications."}],"markDefs":[],"style":"normal"},{"_key":"86bd585f70cd","_type":"block","children":[{"_key":"1e522aaa7f61","_type":"span","marks":[],"text":"📌 GPA benchmarks for selective colleges (2026)"}],"markDefs":[],"style":"normal"},{"_key":"690f9ddc2adb","_type":"block","children":[{"_key":"ed5ff6fb85fd","_type":"span","marks":["strong"],"text":"Top 20 schools:"},{"_key":"7087d44ce1be","_type":"span","marks":[],"text":" 3.9+ unweighted (weighted typically 4.3–4.8)"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"22a7b5268d17","_type":"block","children":[{"_key":"b1fe0fa323df","_type":"span","marks":["strong"],"text":"Top 50 schools:"},{"_key":"389d899441f0","_type":"span","marks":[],"text":" 3.7+ unweighted (weighted 4.0–4.5)"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"a9e88cceaafa","_type":"block","children":[{"_key":"1ef405d5405b","_type":"span","marks":["strong"],"text":"Top 100 schools:"},{"_key":"189a6b240b88","_type":"span","marks":[],"text":" 3.5+ unweighted (weighted 3.8–4.3)"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"04789668ba3b","_type":"block","children":[{"_key":"326c55de8769","_type":"span","marks":["strong"],"text":"State schools:"},{"_key":"241d31091460","_type":"span","marks":[],"text":" 3.0–3.5+ unweighted"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"2b23140e8051","_type":"block","children":[{"_key":"0ed13286a217","_type":"span","marks":[],"text":"8. Which GPA Should You Try to Improve?"}],"markDefs":[],"style":"h2"},{"_key":"8bbbc8108f8c","_type":"block","children":[{"_key":"9c3f9c37195e","_type":"span","marks":[],"text":"Both — but the strategy depends on where you are right now."}],"markDefs":[],"style":"normal"},{"_key":"8e74f252ef48","_type":"block","children":[{"_key":"571b257675c8","_type":"span","marks":["strong"],"text":"Unweighted GPA below 3.0:"},{"_key":"8db55d6efe37","_type":"span","marks":[],"text":" Focus on grades first. The fundamentals matter more than course difficulty at this stage."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"c39a22888aba","_type":"block","children":[{"_key":"c40e28bb9fc9","_type":"span","marks":["strong"],"text":"Unweighted GPA solid (3.3+):"},{"_key":"7cf8ab934494","_type":"span","marks":[],"text":" Start layering in more challenging courses (Honors, AP) to build a strong weighted GPA and demonstrate academic ambition."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"62eb94c3e0de","_type":"block","children":[{"_key":"6bcc71b02879","_type":"span","marks":["strong"],"text":"Junior or senior year:"},{"_key":"72a8b034b96b","_type":"span","marks":[],"text":" Your weighted GPA is mostly set. Focus on your senior course load, strong AP exam scores, and reporting your GPA correctly on applications."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"0afbb05048fe","_type":"block","children":[{"_key":"594a2c35ea02","_type":"span","marks":[],"text":"For a step-by-step calculation walkthrough and the most common errors to avoid, read our guide: "},{"_key":"f9fa06114617","_type":"span","marks":["fdd94e36535e","strong"],"text":"How to Calculate Your GPA in 5 Minutes"},{"_key":"9f64ad3bc510","_type":"span","marks":[],"text":"."}],"markDefs":[{"_key":"fdd94e36535e","_type":"link","href":"https://edutoolshub.com/blog/how-to-calculate-your-gpa-in-5-minutes"}],"style":"normal"},{"_key":"43b122cf50e2","_type":"block","children":[{"_key":"0d9cd951fd15","_type":"span","marks":[],"text":"9. Quick Reference: Weighted vs Unweighted GPA at a Glance"}],"markDefs":[],"style":"h2"},{"_key":"f19bcff2fb3a","_type":"block","children":[{"_key":"1b7ca586ba5c