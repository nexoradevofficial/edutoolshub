:"e4f7e42c2b93","_type":"block","children":[{"_key":"7bbe8abd19b1","_type":"span","marks":[],"text":"An A in regular English and an A in AP Physics both contribute 4.0 grade points to your unweighted GPA. The courses are treated identically. Unweighted GPA gives admissions officers a consistent baseline to compare students across different schools and districts."}],"markDefs":[],"style":"normal"},{"_key":"03b7404ff845","_type":"block","children":[{"_key":"26ad0ad34c68","_type":"span","marks":[],"text":"2. What Is a Weighted GPA?"}],"markDefs":[],"style":"h2"},{"_key":"2de1c25fd233","_type":"block","children":[{"_key":"19cc96a4802a","_type":"span","marks":[],"text":"A "},{"_key":"9259052ce118","_type":"span","marks":["strong"],"text":"weighted GPA"},{"_key":"db722d983531","_type":"span","marks":[],"text":" adds bonus grade points for harder courses — typically "},{"_key":"5782bf89e6b9","_type":"span","marks":["strong"],"text":"Honors, AP (Advanced Placement), IB (International Baccalaureate)"},{"_key":"7f837747c125","_type":"span","marks":[],"text":", or dual-enrollment college classes. The most common weighted scale goes up to "},{"_key":"d5259ef1c587","_type":"span","marks":["strong"],"text":"5.0"},{"_key":"cb94c6c604bb","_type":"span","marks":[],"text":"."}],"markDefs":[],"style":"normal"},{"_key":"a72d811dcab0","_type":"block","children":[{"_key":"d9290ac15927","_type":"span","marks":[],"text":"Weighted GPA scale — typical bonus points by course level"}],"markDefs":[],"style":"normal"},{"_key":"0bee1a4a068d","_type":"block","children":[{"_key":"2a6b7d5eafc9","_type":"span","marks":[],"text":"Course Level"}],"markDefs":[],"style":"normal"},{"_key":"7e8ad9f9e477","_type":"block","children":[{"_key":"f95fc2e74f37","_type":"span","marks":[],"text":"A = Grade Points"}],"markDefs":[],"style":"normal"},{"_key":"334a9e1796f0","_type":"block","children":[{"_key":"5e78b6031884","_type":"span","marks":[],"text":"B = Grade Points"}],"markDefs":[],"style":"normal"},{"_key":"f