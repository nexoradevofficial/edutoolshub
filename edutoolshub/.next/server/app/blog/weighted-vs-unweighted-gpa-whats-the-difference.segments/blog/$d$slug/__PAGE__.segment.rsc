uire."}],"markDefs":[{"_key":"f9fc9ff0ecd9","_type":"link","href":"https://edutoolshub.com/tools/gpa-calculator"}],"style":"normal"},{"_key":"aae7bd681a2a","_type":"block","children":[{"_key":"7c76185f8eec","_type":"span","marks":[],"text":"🔗 Related tools & guides"}],"markDefs":[],"style":"h3"},{"_key":"c9d550c644db","_type":"block","children":[{"_key":"019511346e74","_type":"span","marks":["cd457aa7f6fc"],"text":"Free GPA Calculator — weighted & unweighted"},{"_key":"df5948e2a3ae","_type":"span","marks":[],"text":" "},{"_key":"288afcbda258","_type":"span","marks":["a03f66f1cf78"],"text":"How to Calculate Your GPA in 5 Minutes"},{"_key":"c24c0cf7ca8d","_type":"span","marks":[],"text":" "},{"_key":"a30d17d78bd1","_type":"span","marks":["3867b897f24e"],"text":"More GPA guides on the EduToolsHub blog"},{"_key":"ff3acf3ef654","_type":"span","marks":[],"text":" "},{"_key":"f5f458cd56d3","_type":"span","marks":["b200a5a35f0c"],"text":"All student tools — free & no signup"}],"markDefs":[{"_key":"cd457aa7f6fc","_type":"link","href":"https://edutoolshub.com/tools/gpa-calculator"},{"_key":"a03f66f1cf78","_type":"link","href":"https://edutoolshub.com/blog/how-to-calculate-your-gpa-in-5-minutes"},{"_key":"3867b897f24e","_type":"link","href":"https://edutoolshub.com/blog"},{"_key":"b200a5a35f0c","_type":"link","href":"https://edutoolshub.com/tools"}],"style":"normal"},{"_key":"2c9e4808c8de","_type":"block","children":[{"_key":"a1d05a3e472f","_type":"span","marks":[],"text":"Tagged:"}],"markDefs":[],"style":"normal"},{"_key":"bab1fe69cc17","_type":"block","children":[{"_key":"fb43d0f48a08","_type":"span","marks":["3282a5fc85a9"],"text":"weighted vs unweighted GPA"},{"_key":"9b618c478b38","_type":"span","marks":["95c961201a6c"],"text":"GPA calculator"},{"_key":"6d515f493041","_type":"span","marks":[],"text":" "},{"_key":"dffacffe818a","_type":"span","marks":["6e9cf978df3c"],"text":"college admissions GPA"},{"_key":"00fb862ae2a3","_type":"span","marks":["ca97fd93200a"],"text":"AP 