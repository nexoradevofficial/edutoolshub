2c:T452,data:image/png;base64,:T452,data:image/png;base64,:["$","$L2b",null,{"initialPosts":[{"_id":"1373f29f-8b15-4a25-af43-0fcb37971132","excerpt":"Discover the most efficient way to manage monthly classroom registers. Learn how automated holiday mapping and custom tracking columns save hours of administrative work.","mainImage":{"_type":"image","alt":"A teacher's hand interactively creating a monthly attendance sheet on a clean digital calendar interface with holiday highlights.","asset":{"_id":"image-b425a118a1a7d73bc3117c45c7b93c46ca6c30a6-1024x559-png","metadata":{"dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.8318425760286225,"height":559,"width":1024},"lqip":"data:image/png;base64,"},"url":"https://cdn.sanity.io/images/djth6w3n/production/b425a118a1a7d73bc3117c45c7b93c46ca6c30a6-1024x559.png"},"caption":"A teacher's hand interactively creating a monthly attendance sheet on a clean digital calendar interface with holiday highlights."},"publishedAt":"2026-06-11T19:19:23.008Z","slug":"how-to-create-monthly-attendance-sheet-with-holidays","title":"Monthly Attendance Sheet Generator With Holidays","_insightImage":{"src":"https://cdn.sanity.io/images/djth6w3n/production/b425a118a1a7d73bc3117c45c7b93c46ca6c30a6-1024x559.png?rect=289,0,447,559&w=800&h=1000&fit=crop&auto=format","srcSet":"https://cdn.sanity.io/images/djth6w3n/production/b425a118a1a7d73bc3117c45c7b93c46ca6c30a6-1024x559.png?rect=289,0,447,559&w=500&h=625&fit=crop&auto=format 500w, https://cdn.sanity.io/images/djth6w3n/production/b425a118a1a7d73bc3117c45c7b93c46ca6c30a6-1024x559.png?rect=289,0,447,559&w=800&h=1000&fit=crop&auto=format 800w, https://cdn.sanity.io/images/djth6w3n/production/b425a118a1a7d73bc3117c45c7b93c46ca6c30a6-1024x559.png?rect=289,0,447,559&w=1100&h=1375&fit=crop&auto=format 1100w","lqip":"data:image/png;base64,","alt":"A teacher's hand interactively creating a monthly attendance sheet on a clean digital calendar interface with holiday highlights."}},{"_id":"b6d563cd